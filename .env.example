# GO-EquityQA environment variables
# Copy this file to .env and fill in the values. .env is git-ignored.

# --- API keys for the evaluated models (providers without a key are skipped) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- NCBI E-utilities (citation verification and coverage proxy) ---
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=            # optional: 10 requests/s with a key, 3 requests/s without

# --- Model versions (optional overrides; defaults are the versions used in the study) ---
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-opus-4-8
# GEMINI_MODEL=gemini-3.1-pro-preview
# JUDGE_BACKEND=anthropic
# JUDGE_MODEL=claude-opus-4-8

# --- Large runs (optional) ---
# ITEMS_CSV=data/items_v3_300.csv
# PACE_SECONDS=1.0                                   # delay between API calls
# CHECKPOINT_JSONL=results/confirmatory_ckpt.jsonl   # incremental save and resume
